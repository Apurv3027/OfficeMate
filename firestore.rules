rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function memberPath(groupId, userId) {
      return /databases/$(database)/documents/groups/$(groupId)/members/$(userId);
    }

    function validPurchaseSplit() {
      let data = request.resource.data;

      return data.participantIds is list
        && data.participantIds.size() >= 1
        && data.participantIds.size() <= 50

        && data.participantIds.toSet().size()
          == data.participantIds.size()

        && data.splitAmounts is map
        && data.splitAmounts.size() == data.participantIds.size()

        && data.splitAmounts.keys().hasAll(data.participantIds)

        && data.splitType in ['equal', 'custom']

        && data.amountPaise is int
        && data.amountPaise > 0;
    }

    function validPurchaseParticipant(groupId, userId) {
      return exists(memberPath(groupId, userId))
        && get(memberPath(groupId, userId)).data.isActive == true;
    }

    // User profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId);
    }

    // Group invitation codes
    match /groupInvites/{inviteCode} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.createdBy == request.auth.uid;
    }

    // Groups
    match /groups/{groupId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAuthenticated();

      // Group members subcollection
      match /members/{memberId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && memberId == request.auth.uid;
        allow update: if isAuthenticated();
      }

      // Group purchases subcollection
      match /purchases/{purchaseId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated()
          && request.resource.data.keys().hasAll([
            'title',
            'description',
            'categoryId',
            'categoryName',
            'amountPaise',
            'paidBy',
            'paidByName',
            'participantIds',
            'splitAmounts',
            'splitType',
            'purchasedAt',
            'createdBy',
            'createdAt',
            'updatedAt'
          ])
          && request.resource.data.keys().hasOnly([
            'title',
            'description',
            'categoryId',
            'categoryName',
            'amountPaise',
            'paidBy',
            'paidByName',
            'participantIds',
            'splitAmounts',
            'splitType',
            'purchasedAt',
            'createdBy',
            'createdAt',
            'updatedAt'
          ])
          && (
            (
              request.resource.data.categoryId == 'buttermilk'
              && request.resource.data.categoryName == 'Buttermilk'
            )
            ||
            (
              request.resource.data.categoryId == 'tea_coffee'
              && request.resource.data.categoryName == 'Tea & Coffee'
            )
            ||
            (
              request.resource.data.categoryId == 'snacks'
              && request.resource.data.categoryName == 'Snacks'
            )
            ||
            (
              request.resource.data.categoryId == 'lunch'
              && request.resource.data.categoryName == 'Lunch'
            )
            ||
            (
              request.resource.data.categoryId == 'cold_drinks'
              && request.resource.data.categoryName == 'Cold Drinks'
            )
            ||
            (
              request.resource.data.categoryId == 'other'
              && request.resource.data.categoryName == 'Other'
            )
          )
          && validPurchaseSplit()
          && request.resource.data.participantIds.hasAll(
            request.resource.data.splitAmounts.keys()
          )
          && validPurchaseParticipant(
            groupId,
            request.resource.data.paidBy
          );
        allow update, delete: if isAuthenticated();
      }
    }

    // Collection group query support for getMyGroups()
    match /{path=**}/members/{memberId} {
      allow read: if isAuthenticated();
    }
  }
}
